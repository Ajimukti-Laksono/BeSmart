APP_NAME=BeasiswaSmart (BeSmart)
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Database MySQL 8.0+
DATABASE_URL=mysql+pymysql://root:@localhost:3306/besmart_db?charset=utf8mb4

# JWT Security (Ganti JWT_SECRET_KEY di production dengan string acak minimal 32 karakter)
JWT_SECRET_KEY=ganti-dengan-secret-key-yang-aman-minimal-32-karakter
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (pisahkan dengan koma atau format JSON array)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload berkas pendaftar
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

